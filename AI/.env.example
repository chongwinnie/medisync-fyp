# MediSync AI backend — example environment.
# Copy to AI/.env and fill in real values. Never commit AI/.env or .env.local.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/medisync
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=

# ---------------------------------------------------------------------------
# LLM — OpenAI is PRIMARY. FreeLLMAPI is optional fallback only when OpenAI
# key is absent. Prefer school/production OpenAI credit grant when available.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REQUEST_TIMEOUT_SEC=45
PREFER_OPENAI=true

# Optional FreeLLMAPI proxy (disabled automatically when OPENAI_API_KEY is set)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_EMBEDDING_FAMILY=text-embedding-3-large
FREELLM_REQUEST_TIMEOUT_SEC=12

# Mem0 long-term agent memory
# oss = self-hosted Memory.from_config (recommended for FYP / PHI)
# cloud = Mem0 Platform (requires MEM0_API_KEY)
# off = disable add/search
MEM0_MODE=oss
MEM0_API_KEY=
MEM0_VECTOR_PROVIDER=chroma
MEM0_COLLECTION_NAME=medisync_mem0
MEM0_LLM_MODEL=gpt-4o-mini
# Empty MEM0_EMBEDDER_MODEL → reuse OPENAI_EMBEDDING_MODEL / FREELLMAPI family
MEM0_EMBEDDER_MODEL=
# Prefer FreeLLM for Mem0 extraction/embed when FREELLMAPI_API_KEY is set
# (preserves OpenAI quota for chat). Set false to force OpenAI for Mem0.
MEM0_PREFER_FREELLM=true

LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=medisync

# Email — Gmail OAuth preferred; Resend is fallback
RESEND_API_KEY=
RESEND_FROM=MediSync <onboarding@resend.dev>

# Google OAuth (Gmail send + Calendar)
# One-time setup:  .venv/bin/python scripts/google_oauth_setup.py
# Google Cloud Console → Credentials → Authorized redirect URIs must include EXACTLY:
#   http://localhost:8090/
# Enable APIs: Gmail API, Google Calendar API. Add test users if consent screen is Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:8090/
GOOGLE_CALENDAR_ID=primary
# LIVE Gmail smoke recipient for scripts/strict_ext1_tests.py
GOOGLE_TEST_TO=
# Optional: service-account JSON string for Calendar-only (legacy)
GOOGLE_CALENDAR_CREDENTIALS=

# Stripe payroll (PaymentIntent demo; optional Connect Transfer via staff.stripe_connect_account_id)
# Use sk_test_... for FYP demo. Admin-only via process_stripe_payroll user_role gate.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CURRENCY=myr
STRIPE_WEBHOOK_SECRET=

CELERY_BROKER_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:3000
